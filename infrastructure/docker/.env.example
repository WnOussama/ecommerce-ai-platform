# =============================================================================
# SaaS AI E-commerce - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# -----------------------------------------------------------------------------
# DATABASE - PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=saas_ecommerce
DB_USER=saas_user
DB_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# CACHE - Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# LLM CONFIGURATION
# -----------------------------------------------------------------------------
# Chat LLM: Groq only (free tier, OpenAI-compatible API). No mock, no
# fallback - get a free key at https://console.groq.com/keys.
LLM_GROQ_API_KEY=

# Embeddings for RAG product search (Groq has no embeddings API). Optional -
# without it, RAG uses a real local model (all-MiniLM-L6-v2, downloaded once).
LLM_OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Minimum 32 characters required
SECURITY_JWT_SECRET_KEY=your-very-secure-jwt-secret-key-min-32-chars
API_KEY_PREFIX=sk_

# Encrypts each tenant's HMAC request-signing secret at rest (min 32 chars).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECURITY_API_KEY_ENCRYPTION_KEY=your-very-secure-api-key-encryption-key-min-32-chars

# Dev-only: lets ai-core accept an unauthenticated X-Tenant-ID header instead
# of a real API key. This is an explicit opt-in, independent of ENVIRONMENT -
# leave it false/unset anywhere reachable from outside your machine;
# docker-compose.dev.yml sets it to true for itself.
SECURITY_ALLOW_DEV_TENANT_HEADER=false

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# SERVICES PORTS
# -----------------------------------------------------------------------------
AI_CORE_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443
BACKOFFICE_PORT=8090

# -----------------------------------------------------------------------------
# BACKOFFICE - Laravel/Filament Admin Dashboard
# -----------------------------------------------------------------------------
# Generate with: php artisan key:generate --show (from src/backoffice)
BACKOFFICE_APP_KEY=
# Dev-only auth: a tenant UUID from `python -m scripts.seed_demo_data`.
# See docs/deployment/docker.md - tenant creation / real API keys are not
# yet implemented on the AI Core side, so this is the only working auth
# path today.
BACKOFFICE_TENANT_ID=
BACKOFFICE_API_KEY=

# -----------------------------------------------------------------------------
# PRESTASHOP DEMO STOREFRONT (optional - only needed for the storefront demo,
# see docker-compose.dev.yml's prestashop/mysql services)
# -----------------------------------------------------------------------------
PS_DB_PASSWORD=your_secure_password_here
PS_DB_NAME=prestashop
PS_DOMAIN=localhost:8080
PS_ADMIN_EMAIL=admin@example.com
PS_ADMIN_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES (Optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# SLACK_WEBHOOK=
# SENDGRID_API_KEY=


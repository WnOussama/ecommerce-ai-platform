# =============================================================================
# SaaS AI E-commerce - Environment Variables
# =============================================================================
#
# IMPORTANT: Copy this file to .env and fill in ALL required values.
# The application will NOT start if required secrets are missing or invalid.
#
# Generate secure secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
ENVIRONMENT=development  # development, staging, production

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# FastAPI is the EXCLUSIVE owner of this database.
# Laravel communicates via REST API only.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saas_ecommerce
DB_USER=saas_user
DB_PASSWORD=your_secure_database_password  # REQUIRED: min 8 chars

# Pool configuration (adjust for production)
DB_POOL_SIZE=5         # Dev: 5, Prod: 20
DB_MAX_OVERFLOW=10     # Dev: 10, Prod: 40
DB_POOL_RECYCLE=3600   # Recycle connections after 1 hour

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Optional in dev, REQUIRED in production

# -----------------------------------------------------------------------------
# VECTOR STORE (ChromaDB)
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma

# -----------------------------------------------------------------------------
# LLM CONFIGURATION
# -----------------------------------------------------------------------------
# Chat LLM: Groq only (free tier, OpenAI-compatible API). No mock, no
# fallback - get a free key at https://console.groq.com/keys. The app
# raises a clear startup error if this is missing/invalid.
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=openai/gpt-oss-120b

# Embeddings for RAG product search (Groq has no embeddings API, so this
# is separate from the chat LLM above). Optional - without it, RAG uses a real
# local model (all-MiniLM-L6-v2, ONNX, ~80 MB downloaded once into data/). Set
# a key only if you want OpenAI's embeddings instead.
LLM_OPENAI_API_KEY=
LLM_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# SECURITY - CRITICAL SECRETS (NO DEFAULTS!)
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# REQUIRED: JWT signing secret (min 32 chars)
SECURITY_JWT_SECRET_KEY=GENERATE_ME_WITH_secrets_token_hex_32

# REQUIRED: API key encryption (min 32 chars)
SECURITY_API_KEY_ENCRYPTION_KEY=GENERATE_ME_WITH_secrets_token_hex_32

# REQUIRED in production: Database field encryption
SECURITY_DB_ENCRYPTION_KEY=GENERATE_ME_WITH_secrets_token_hex_32

# -----------------------------------------------------------------------------
# SECURITY - OPTIONAL CONFIGURATION
# -----------------------------------------------------------------------------
SECURITY_JWT_ALGORITHM=HS256
SECURITY_JWT_EXPIRATION_HOURS=24
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_REQUESTS_PER_MINUTE=60
SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# AI Security
SECURITY_PROMPT_INJECTION_DETECTION_ENABLED=true
SECURITY_OUTPUT_GUARDRAILS_ENABLED=true
SECURITY_ADMIN_ACTION_CONFIRMATION_REQUIRED=true

# Dev-only: accept an unauthenticated X-Tenant-ID header instead of a real
# API key. Must be set explicitly - it no longer follows from
# ENVIRONMENT=development, since that's the default everywhere. Never set
# this to true anywhere reachable outside your own machine.
SECURITY_ALLOW_DEV_TENANT_HEADER=false

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
MONITORING_LOG_LEVEL=INFO
MONITORING_LOG_FORMAT=json
MONITORING_PROMETHEUS_ENABLED=true

# -----------------------------------------------------------------------------
# MULTI-TENANT
# -----------------------------------------------------------------------------
TENANT_ISOLATION_MODE=logical


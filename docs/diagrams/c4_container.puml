@startuml C4_Container

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C4 Container Diagram - E-commerce AI Platform (as actually deployed)

Person(client, "Client E-commerce", "Visiteur/Acheteur du site marchand")
Person(admin, "Administrateur", "Gère les règles, consulte les insights")

System_Ext(prestashop, "PrestaShop", "Catalogue produits/catégories - pas de commandes")
System_Ext(llm, "Groq", "LLM_GROQ_API_KEY requise - pas de mock, pas de fallback")

System_Boundary(platform, "E-commerce AI Platform") {
    Container(backoffice, "Backoffice", "Laravel / Filament", "Client REST pur - aucun accès direct a la base (imposé par l'architecture, pas seulement la convention)")

    Container_Boundary(aicore, "AI Core API - FastAPI (monolithe, un seul processus déployé)") {
        Component(chat_ep, "Chat", "endpoint", "Guardrails -> règles tenant -> RAG -> LLM -> persistance")
        Component(rules_ep, "Rules Engine", "evaluator + repository", "conditions/action JSONB, évaluées par priorité")
        Component(admin_agent, "Admin Agent", "AdminCommandParser + AdminAISafetySystem", "actions prédéfinies uniquement, dry-run -> confirmation -> exécution")
        Component(insights_ep, "Insights / Analytics", "service", "agrégats réels sur messages/conversations/products/coupons")
    }

    ContainerDb(postgres, "PostgreSQL", "SQL", "Propriétaire exclusif: AI Core (Alembic)")
    ContainerDb(chromadb, "ChromaDB", "Vector DB", "Embeddings produits pour le RAG")
    ContainerDb(redis, "Redis", "Cache", "Rate limiting + état des actions admin (AdminAISafetySystem)")
}

Rel(client, chat_ep, "Pose une question", "HTTPS/JSON")
Rel(admin, backoffice, "Configure les règles, consulte", "HTTPS")
Rel(backoffice, aicore, "REST uniquement", "HTTPS/JSON")

Rel(chat_ep, rules_ep, "Évalue après classification d'intention")
Rel(chat_ep, llm, "Génère la réponse (ou court-circuité par une règle canned_response)")
Rel(admin_agent, llm, "suggest_marketing_strategy uniquement")

Rel(aicore, postgres, "CRUD (SQLAlchemy async)", "TCP")
Rel(chat_ep, chromadb, "Recherche produits pertinents", "HTTP")
Rel(aicore, redis, "Rate limit + pending actions", "TCP")

Note right of prestashop
  Pas de synchronisation automatique en continu dans le
  déploiement actuel - le catalogue est indexé via
  scripts/seed_demo_data.py ou un job manuel.
end note

@enduml

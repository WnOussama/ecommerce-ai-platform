@startuml Deployment_Diagram

title Diagramme de déploiement - environnement de développement (Docker Compose)

skinparam node {
    BackgroundColor #f7f4ec
    BorderColor #333333
}
skinparam database {
    BackgroundColor #e3f2fd
}
skinparam cloud {
    BackgroundColor #fce4ec
}

node "Poste de développement / Serveur hôte" {

    node "Docker network: saas_network (bridge)" {

        node "saas_ai_core\n<<container>>" as aicore {
            component "FastAPI (uvicorn --reload)" as aicore_app
            note right of aicore
                Image buildée depuis
                ai-core.Dockerfile (target: development)
                Bind mount live : src/ai-core -> /app
                Limites : 1 vCPU / 1 Go RAM
            end note
        }

        node "saas_backoffice\n<<container>>" as backoffice {
            component "Laravel / Octane (PHP-FPM)" as bo_app
            note right of backoffice
                Image buildée depuis
                backoffice.Dockerfile (target: development)
                Pas de bind mount : déploiement par docker cp en dev
                Limites : 0.5 vCPU / 512 Mo RAM
            end note
        }

        database "saas_postgres\n<<container>>\nPostgreSQL 16-alpine" as pg {
            storage "volume: postgres_data" as pg_vol
        }

        database "saas_redis\n<<container>>\nRedis 7-alpine\n--appendonly yes" as redis {
            storage "volume: redis_data" as redis_vol
        }

        database "saas_chromadb\n<<container>>\nchromadb/chroma:0.4.22" as chroma {
            storage "volume: chroma_data" as chroma_vol
        }

        node "saas_prometheus\n<<container>> (profil: monitoring)" as prom {
            storage "volume: prometheus_data"
        }

        node "saas_grafana\n<<container>> (profil: monitoring)" as grafana {
            storage "volume: grafana_data"
        }
    }
}

cloud "PrestaShop\n(externe)" as prestashop
cloud "OpenAI / Anthropic\n(externe, LLM_PROVIDER=mock en dev)" as llm

actor "Navigateur\n(client / admin)" as browser

browser --> aicore : "localhost:8000\nAPI_PORT"
browser --> backoffice : "127.0.0.1:8090\nBACKOFFICE_PORT"
browser --> grafana : "localhost:3000\nGRAFANA_PORT"
browser --> prom : "localhost:9090\nPROMETHEUS_PORT"

backoffice --> aicore : "REST/JSON (réseau interne)\nhttp://ai-core:8000/api/v1"
aicore --> pg : "TCP 5432 (interne)"
aicore --> redis : "TCP 6379 (interne)"
aicore --> chroma : "HTTP 8000 (interne)\nCHROMA_PORT: 8100 -> hôte"
aicore ..> prestashop : "Webservice API\n(synchronisation catalogue)"
aicore ..> llm : "API HTTPS\n(désactivé en dev : mock)"
prom --> aicore : "scrape /metrics"
grafana --> prom : "requêtes PromQL"

pg -- pg_vol
redis -- redis_vol
chroma -- chroma_vol

note bottom of aicore
    Seul composant à détenir des identifiants
    de connexion PostgreSQL - imposé par la
    configuration réseau, pas seulement la convention.
end note

@enduml
